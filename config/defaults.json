{
  "version": 1,
  "general": {
    "startupBehavior": "newTab",
    "homePage": "ghost://newtab",
    "searchEngine": "duckduckgo",
    "profileName": "Ghost User",
    "newTabModules": {
      "weather": true,
      "shortcuts": true,
      "briefing": true,
      "focus": true
    }
  },
  "appearance": {
    "theme": "dark",
    "showBookmarksBar": false,
    "fontSize": 16,
    "zoomLevel": 100
  },
  "content": {
    "autoplay": true,
    "fullScreenVideo": true,
    "youtubeShortsAsNormalVideos": true,
    "siteSettings": {
      "javascript": "allow",
      "popups": "block",
      "notifications": "ask",
      "location": "ask",
      "camera": "ask",
      "microphone": "ask"
    }
  },
  "privacy": {
    "doNotTrack": true,
    "blockThirdPartyCookies": true,
    "clearDataOnExit": false,
    "httpsOnly": false
  },
  "downloads": {
    "askWhereToSave": false,
    "defaultPath": ""
  },
  "languages": {
    "spellCheck": true
  },
  "system": {
    "hardwareAcceleration": true,
    "backgroundApps": false,
    "proxyMode": "system"
  },
  "protection": {
    "trackingLevel": "aggressive",
    "httpsUpgrade": true,
    "blockFingerprinting": true,
    "blockScripts": false,
    "safeBrowsing": true
  },
  "accessibility": {
    "caretBrowsing": false,
    "highContrast": false
  }
}
